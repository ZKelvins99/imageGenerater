# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Local config & data (never commit secrets / generated assets)
config/settings.json
config/secrets.json
data/history.jsonl
data/outputs/*
!data/outputs/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PyInstaller / NSIS build artifacts
build/
dist/
*.pyc
app_icon.ico

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.png
!static/**/*.png
test_output.png

# Local tooling / runtime artifacts
.codegraph/
.cursor/
.tmp-*
.instance.lock
data/*.db
data/*.db-shm
data/*.db-wal
